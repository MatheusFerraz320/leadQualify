
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"


JWT_SECRET=""


JWT_EXPIRES_IN="7d"


# Origem (origin) do frontend permitida no CORS (ex.: https://app.exemplo.com)
FRONTEND_URL="http://localhost:5173"


# Autenticação via cookie HttpOnly (SameSite=Lax).
# COOKIE_SECURE deve ser "true" em produção (HTTPS). Em dev (localhost) deixe "false".
# Front e API precisam estar no mesmo domínio (same-site) para o cookie funcionar.
COOKIE_NAME="access_token"
COOKIE_SECURE="false"
COOKIE_SAMESITE="lax"


# Identificadores dos campos personalizados do RD Station (cf_<api_identifier>)
# Ex.: campo "Produto de interesse" com identifier cf_produto_ou_servico
RD_FIELD_PRODUCT="cf_produto_ou_servico"
RD_FIELD_FINALITY="cf_finalidade"
